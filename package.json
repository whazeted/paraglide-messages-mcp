{
	"name": "paraglide-messages-mcp",
	"version": "0.3.0",
	"description": "Stateless MCP service for durable OpenAI Batch translations of Paraglide / inlang messages",
	"license": "MIT",
	"mcpName": "io.github.whazeted/paraglide-messages-mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/whazeted/paraglide-messages-mcp.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"packageManager": "pnpm@10.33.2",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"bin": {
		"paraglide-messages-mcp": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"skill",
		"README.md",
		"COMPATIBILITY.md",
		"DEVELOPMENT.md"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"paraglide",
		"inlang",
		"i18n",
		"translation"
	],
	"scripts": {
		"build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --exclude 'test/e2e/**' --exclude 'test/benchmark/**'",
		"test:e2e": "pnpm build && vitest run test/e2e/e2e.test.ts",
		"test:all": "pnpm build && vitest run --exclude 'test/benchmark/**'",
		"bench": "vitest run test/benchmark/benchmark.test.ts",
		"bench:subagents": "vitest run test/benchmark/benchmark-subagents.test.ts",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.3.1",
		"flat": "^6.0.1",
		"openai": "^7.30.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "^2.3.1",
		"@types/node": "^24.19.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
